# Локальные секреты: cp .env.example .env
# Файл .env в репозиторий не попадает — см. .gitignore.
#
# Кодом пока ничего из этого не используется: хранение в памяти, аутентификации нет.
# Контракт задан заранее, чтобы к моменту появления секретов маршрут мимо репозитория
# уже существовал и не пришлось ничего вычищать из истории.
#
# Двойное подчёркивание — это вложенность конфигурации .NET:
# ConnectionStrings__Postgres соответствует секции ConnectionStrings, ключу Postgres.

# PostgreSQL (этап 1)
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=crm;Username=crm;Password=

# Подпись JWT (этап 1). Минимум 32 байта: openssl rand -base64 48
Jwt__SigningKey=

# Почта для уведомлений из процессов
Smtp__Host=
Smtp__Port=587
Smtp__User=
Smtp__Password=
